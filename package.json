{
  "name": "next-js-boilerplate",
  "author": "Ixartz (https://github.com/ixartz)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "npm run dev:next",
    "build:next": "next build --webpack",
    "build": "npm run build:next",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "npm-run-all -s lint:eslint lint:emoji",
    "lint:eslint": "eslint .",
    "lint:emoji": "node ./scripts/check-emoji.mjs",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip --include unlisted,unresolved --no-config-hints",
    "check:circular": "node ./scripts/check-circular.mjs",
    "guard:types": "tsc --noEmit",
    "guard:lint": "eslint . --max-warnings=0",
    "guard:circular": "madge --circular --extensions ts,tsx --ts-config ./tsconfig.json src",
    "guard:deps": "depcheck",
    "guard:build": "next build",
    "guard:arch": "node ./scripts/check-architecture.js",
    "guard:rsc": "node ./scripts/check-rsc-usage.js",
    "guard:all": "npm run guard:types && npm run guard:lint && npm run guard:circular && npm run guard:arch && npm run guard:rsc",
    "guard:rsc-ratio": "node ./scripts/check-rsc-ratio.js",
    "guard:perf": "node ./scripts/check-performance.js",
    "guard:report": "node ./scripts/governance-report.js",
    "commit": "commit",
    "format:check": "prettier --check \"src/modules/common/**/*.{ts,tsx}\" \"src/app/api/_shared/**/*.ts\" \"src/middleware.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.mts",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-google-maps/api": "^2.20.8",
    "@sentry/nextjs": "^10.38.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.59.20",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.575.0",
    "next": "^16.1.6",
    "posthog-js": "^1.336.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.56.4",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@chromatic-com/playwright": "^0.12.8",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@commitlint/prompt-cli": "^20.4.1",
    "@eslint-react/eslint-plugin": "^2.9.3",
    "@faker-js/faker": "^10.2.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@next/eslint-plugin-next": "^16.1.6",
    "@playwright/test": "^1.58.1",
    "@spotlightjs/spotlight": "^4.10.0",
    "@storybook/addon-a11y": "^10.2.4",
    "@storybook/addon-docs": "^10.2.4",
    "@storybook/addon-vitest": "^10.2.4",
    "@storybook/nextjs-vite": "^10.2.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.3.1",
    "eslint-plugin-jsdoc": "^62.5.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.5.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^10.2.4",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "husky": "^9.1.7",
    "knip": "^5.83.0",
    "lefthook": "^2.0.16",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "semantic-release": "^25.0.3",
    "storybook": "^10.2.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.0.5"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  }
}
